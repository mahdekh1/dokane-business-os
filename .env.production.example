# Copy to `.env.production` on the server and fill in real values.
# NEVER commit .env.production (it holds secrets); only this .example is tracked.

# ---- Postgres (runs as a container; these values create the database) ----
POSTGRES_USER=dokane
POSTGRES_PASSWORD=CHANGE_ME_use_a_strong_password
POSTGRES_DB=dokane

# ---- Auth ----
# Generate once with:  openssl rand -base64 48
AUTH_SECRET=CHANGE_ME_long_random_secret

# ---- Public address & HTTPS ----
# First deploy (server IP, plain HTTP): keep SITE_ADDRESS=:80 and set WEB_ORIGIN to the IP.
# Later, with a domain (automatic HTTPS): SITE_ADDRESS=dokane.example.com
#                                         WEB_ORIGIN=https://dokane.example.com
SITE_ADDRESS=:80
WEB_ORIGIN=http://YOUR_SERVER_IP

# Browser → API base URL, inlined into the web build. The same-origin default
# ("/api/v1") means no CORS and no server IP baked into the image. Leave as-is
# unless the web app is served from a different origin than the API.
NEXT_PUBLIC_API_URL=/api/v1
