// Dokane Business OS — Prisma schema.
// Phase 1 (Task 1.1): platform & identity core. Tenant-owned module tables are
// added in their own phases. See docs/DATA_MODEL.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum BusinessStatus {
  PENDING_APPROVAL
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  SUSPENDED
}

enum RoleScope {
  PLATFORM
  BUSINESS
}

enum MembershipStatus {
  ACTIVE
  DISABLED
}

model User {
  id              String   @id @default(uuid()) @db.Uuid
  email           String   @unique
  firstName       String
  lastName        String
  phone           String?
  language        String   @default("en")
  passwordHash    String
  status          UserStatus @default(ACTIVE)
  isPlatformAdmin Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberships     BusinessMembership[]

  @@map("users")
}

model Business {
  id           String   @id @default(uuid()) @db.Uuid
  name           String
  slug           String   @unique
  businessType   String?
  offeringTypes  String[] @default([])
  businessNumber String?
  phone          String?
  email          String?
  addressLine1   String?
  addressLine2 String?
  city         String?
  postalCode   String?
  country      String?
  currency     String   @default("USD")
  timezone     String   @default("UTC")
  status       BusinessStatus @default(PENDING_APPROVAL)
  logoKey      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships  BusinessMembership[]
  roles        Role[]

  @@map("businesses")
}

model BusinessMembership {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  status     MembershipStatus @default(ACTIVE)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business   Business @relation(fields: [businessId], references: [id])
  user       User     @relation(fields: [userId], references: [id])
  role       Role     @relation(fields: [roleId], references: [id])

  @@unique([businessId, userId])
  @@index([businessId, userId])
  @@map("business_memberships")
}

// A role is either a system BUSINESS/PLATFORM role (businessId = null) or a
// tenant-custom role (businessId set). A membership may only reference a system
// BUSINESS role or a custom role of the SAME business (enforced in RBAC service).
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  businessId  String?  @db.Uuid
  name        String
  scope       RoleScope
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business    Business? @relation(fields: [businessId], references: [id])
  permissions RolePermission[]
  memberships BusinessMembership[]

  @@index([businessId])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  moduleId    String
  description String?

  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ---- Packaging & modules (Task 1.5) ----

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
}

model Plan {
  id     String  @id @default(uuid()) @db.Uuid
  name   String
  tier   String  @unique // STARTER | GROWTH | BUSINESS | ENTERPRISE
  active Boolean @default(true)

  entitlements  PlanEntitlement[]
  subscriptions Subscription[]

  @@map("plans")
}

model Entitlement {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique
  name        String
  description String?

  plans  PlanEntitlement[]
  addons AddonEntitlement[]

  @@map("entitlements")
}

model PlanEntitlement {
  planId        String @db.Uuid
  entitlementId String @db.Uuid

  plan        Plan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  entitlement Entitlement @relation(fields: [entitlementId], references: [id], onDelete: Cascade)

  @@id([planId, entitlementId])
  @@map("plan_entitlements")
}

model Subscription {
  id         String             @id @default(uuid()) @db.Uuid
  businessId String             @unique @db.Uuid // one active subscription per business (MVP)
  planId     String             @db.Uuid
  status     SubscriptionStatus @default(ACTIVE)
  startedAt  DateTime           @default(now())
  renewsAt   DateTime?

  plan Plan @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

model AddonEntitlement {
  id            String @id @default(uuid()) @db.Uuid
  businessId    String @db.Uuid
  entitlementId String @db.Uuid

  entitlement Entitlement @relation(fields: [entitlementId], references: [id], onDelete: Cascade)

  @@unique([businessId, entitlementId])
  @@map("addon_entitlements")
}

model ModuleState {
  id         String    @id @default(uuid()) @db.Uuid
  businessId String    @db.Uuid
  moduleId   String
  enabled    Boolean   @default(false)
  enabledAt  DateTime?

  @@unique([businessId, moduleId])
  @@map("module_states")
}

// ---- Transactional outbox (Task 1.6) ----

model OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  topic       String
  payload     Json
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([processedAt, createdAt])
  @@map("outbox_events")
}

// ---- Branding (Task 2.4) ----

model Branding {
  id             String   @id @default(uuid()) @db.Uuid
  businessId     String   @unique @db.Uuid
  primaryColor   String   @default("#0E6A57")
  secondaryColor String   @default("#D98E4B")
  fontHeading    String   @default("Fraunces")
  fontBody       String   @default("Hanken Grotesk")
  logoUrl        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("branding")
}

// ---- Audit (Task 1.7) ----

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  businessId  String?  @db.Uuid
  actorUserId String?  @db.Uuid
  actorType   String
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([businessId, createdAt])
  @@map("audit_logs")
}

// ---- Catalog (Phase 3, Task 3.1) — physical + digital goods ----

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  businessId  String   @db.Uuid
  name        String
  slug        String
  description String?
  parentId    String?  @db.Uuid
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  offerings   Offering[]

  @@unique([businessId, slug])
  @@index([businessId])
  @@map("categories")
}

model Offering {
  id             String   @id @default(uuid()) @db.Uuid
  businessId     String   @db.Uuid
  categoryId     String?  @db.Uuid
  type           String // 'physical' | 'digital'
  name           String
  description    String?
  sku            String?
  barcode        String?
  price          Int // minor units
  cost           Int?
  trackInventory Boolean  @default(false)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category       Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants       OfferingVariant[]
  media          OfferingMedia[]

  @@unique([businessId, sku])
  @@unique([businessId, barcode])
  @@index([businessId, active])
  @@index([businessId, categoryId])
  @@map("offerings")
}

model OfferingVariant {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid
  offeringId String   @db.Uuid
  name       String?
  sku        String?
  barcode    String?
  price      Int
  attributes Json
  key        String // canonical sorted attribute key
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  offering   Offering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@unique([offeringId, key])
  @@unique([businessId, sku])
  @@index([offeringId])
  @@map("offering_variants")
}

model OfferingMedia {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid
  offeringId String   @db.Uuid
  storageKey String
  sortOrder  Int      @default(0)
  altText    String?
  createdAt  DateTime @default(now())

  offering   Offering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@index([offeringId])
  @@map("offering_media")
}

// ---- Inventory (Phase 3, Task 3.3) ----

model Location {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid
  name       String
  code       String?
  status     String   @default("ACTIVE")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([businessId])
  @@map("locations")
}

model InventoryItem {
  id                String   @id @default(uuid()) @db.Uuid
  businessId        String   @db.Uuid
  locationId        String   @db.Uuid
  offeringId        String?  @db.Uuid
  variantId         String?  @db.Uuid
  stockableKey      String // 'offering:<id>' | 'variant:<id>'
  quantity          Int      @default(0)
  lowStockThreshold Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([businessId, locationId, stockableKey])
  @@index([businessId, locationId])
  @@map("inventory_items")
}

model InventoryMovement {
  id            String   @id @default(uuid()) @db.Uuid
  businessId    String   @db.Uuid
  locationId    String   @db.Uuid
  offeringId    String?  @db.Uuid
  variantId     String?  @db.Uuid
  movementType  String // INITIAL_STOCK | ADJUSTMENT | SALE | RETURN | TRANSFER_IN | TRANSFER_OUT
  quantityDelta Int
  reason        String?
  referenceType String?
  referenceId   String?
  createdBy     String?  @db.Uuid
  createdAt     DateTime @default(now())

  @@index([businessId, locationId, createdAt])
  @@index([businessId, offeringId])
  @@index([businessId, variantId])
  @@map("inventory_movements")
}

// ---- Customers (Phase 3, Task 3.6) — core registry (CRM builds on this) ----

model Customer {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid
  name       String
  email      String?
  phone      String?
  address    String?
  source     String   @default("MANUAL")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([businessId, email])
  @@index([businessId, phone])
  @@map("customers")
}

model SalesChannel {
  id                    String   @id @default(uuid()) @db.Uuid
  businessId            String   @db.Uuid
  type                  String // ONLINE_STORE | PHYSICAL | MARKETPLACE
  name                  String
  locationId            String?  @db.Uuid
  fulfillmentLocationId String?  @db.Uuid
  settings              Json     @default("{}")
  isDefault             Boolean  @default(false)
  active                Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([businessId])
  @@map("sales_channels")
}

model Order {
  id                String   @id @default(uuid()) @db.Uuid
  businessId        String   @db.Uuid
  channelId         String   @db.Uuid
  locationId        String?  @db.Uuid
  customerId        String?  @db.Uuid
  customerName      String? // snapshot label (from the linked customer, or an ephemeral walk-in name)
  entryMode         String // ONLINE | MANUAL
  fulfillmentStatus String // Axis A
  paymentStatus     String   @default("UNPAID") // Axis B (derived)
  subtotal          Int
  discount          Int      @default(0)
  taxAmount         Int      @default(0)
  total             Int
  amountPaid        Int      @default(0)
  currency          String
  note              String?
  stockCommitted    Boolean  @default(false)
  idempotencyKey    String?
  createdBy         String?  @db.Uuid
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  items    OrderItem[]
  payments Payment[]

  @@unique([businessId, idempotencyKey])
  @@index([businessId, fulfillmentStatus])
  @@index([businessId, channelId])
  @@index([businessId, customerId])
  @@index([businessId, createdAt])
  @@map("orders")
}

model OrderItem {
  id           String   @id @default(uuid()) @db.Uuid
  businessId   String   @db.Uuid
  orderId      String   @db.Uuid
  offeringId   String?  @db.Uuid
  variantId    String?  @db.Uuid
  nameSnapshot String
  skuSnapshot  String?
  unitPrice    Int
  quantity     Int
  discount     Int      @default(0)
  lineTotal    Int
  createdAt    DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([businessId, orderId])
  @@map("order_items")
}

model Payment {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid
  orderId    String   @db.Uuid
  method     String // CASH | BIT
  amount     Int
  currency   String
  reference  String?
  status     String   @default("RECEIVED") // RECEIVED | REFUNDED
  receivedAt DateTime @default(now())
  createdBy  String?  @db.Uuid

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([businessId, orderId])
  @@map("payments")
}

model FinancialEntry {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid
  type       String // INCOME | EXPENSE
  amount     Int
  currency   String
  category   String?
  channelId  String?  @db.Uuid
  orderId    String?  @db.Uuid // the order this income came from (for revenue-by-order)
  customerId String?  @db.Uuid // the order's customer (for revenue-by-customer)
  method     String? // for income: CASH | BIT
  sourceType String? // ORDER_PAYMENT | MANUAL
  sourceId   String?  @db.Uuid // payment id when auto-generated
  note       String?
  entryDate  DateTime @default(now())
  createdBy  String?  @db.Uuid
  createdAt  DateTime @default(now())

  @@unique([businessId, sourceId])
  @@index([businessId, type, entryDate])
  @@index([businessId, channelId])
  @@index([businessId, customerId])
  @@map("financial_entries")
}

// Dormant invoicing infrastructure (Task 4.6). Entities + per-tenant numbering
// exist and orders carry the wiring, but issuance is gated off (NOT_ENABLED).
model Invoice {
  id         String    @id @default(uuid()) @db.Uuid
  businessId String    @db.Uuid
  orderId    String    @db.Uuid
  number     String
  status     String    @default("DRAFT")
  currency   String
  lines      Json      @default("[]")
  totals     Json      @default("{}")
  issuedAt   DateTime?
  createdAt  DateTime  @default(now())

  @@unique([businessId, number])
  @@index([businessId, orderId])
  @@map("invoices")
}

model InvoiceSequence {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @unique @db.Uuid
  nextNumber Int      @default(1)
  updatedAt  DateTime @updatedAt

  @@map("invoice_sequences")
}

// CRM leads — pipeline over the core customers registry (Task 5.1). CRM owns
// this table; customers stay in the core module (linked via customerId).
model Lead {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid
  customerId String?  @db.Uuid // set on conversion (links to the core customer)
  name       String
  email      String?
  phone      String?
  source     String?
  value      Int? // estimated deal value, minor units
  note       String?
  stage      String   @default("NEW") // NEW | CONTACTED | QUALIFIED | CONVERTED | LOST
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([businessId, stage])
  @@index([businessId, customerId])
  @@map("leads")
}

// Project Management (Task 5.2). owner_id / assignee_id → business_memberships.id.
model Project {
  id          String   @id @default(uuid()) @db.Uuid
  businessId  String   @db.Uuid
  name        String
  description String?
  status      String   @default("PLANNING") // PLANNING|ACTIVE|ON_HOLD|COMPLETED|CANCELLED|ARCHIVED
  ownerId     String?  @db.Uuid // business membership id
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks Task[]

  @@index([businessId, status])
  @@map("projects")
}

model Task {
  id          String    @id @default(uuid()) @db.Uuid
  businessId  String    @db.Uuid
  projectId   String    @db.Uuid
  title       String
  description String?
  status      String    @default("TODO") // TODO|IN_PROGRESS|IN_REVIEW|DONE|BLOCKED|CANCELLED
  priority    String    @default("MEDIUM") // LOW|MEDIUM|HIGH|URGENT
  assigneeId  String?   @db.Uuid // business membership id
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([businessId, projectId, status])
  @@index([businessId, assigneeId])
  @@map("tasks")
}

// Calendar (Task 5.4). Appointments are tenant-scoped; external sync is
// scaffolded (CalendarConnection) but dormant until provider creds are set.
model Appointment {
  id          String   @id @default(uuid()) @db.Uuid
  businessId  String   @db.Uuid
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime
  status      String   @default("SCHEDULED") // SCHEDULED|CONFIRMED|COMPLETED|CANCELLED|NO_SHOW
  customerId  String?  @db.Uuid
  assigneeId  String?  @db.Uuid // business membership id
  location    String?
  note        String?
  externalId  String? // id in the synced external calendar
  createdBy   String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([businessId, startsAt])
  @@index([businessId, assigneeId])
  @@map("appointments")
}

model CalendarConnection {
  id              String    @id @default(uuid()) @db.Uuid
  businessId      String    @db.Uuid
  provider        String // GOOGLE | APPLE_CALDAV
  status          String    @default("DISCONNECTED")
  accountEmail    String?
  accessTokenEnc  String? // encrypted at rest
  refreshTokenEnc String? // encrypted at rest
  caldavUrl       String?
  lastSyncAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([businessId, provider])
  @@map("calendar_connections")
}
